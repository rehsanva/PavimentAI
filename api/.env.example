# Copie este arquivo para ".env" (na pasta api) e preencha os valores.
# NUNCA envie o .env para o GitHub.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pavimentai
DB_USER=pavimentai_app
DB_PASSWORD=troque_pela_senha_do_pavimentai_app

# Chave secreta dos tokens de login (mínimo 32 caracteres).
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cole_aqui_a_chave_gerada
JWT_EXPIRA_MINUTOS=60

# "dev" mostra os códigos de verificação no terminal. Em produção use "prod".
AMBIENTE=dev
